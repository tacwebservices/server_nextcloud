# Copy this file to .env and fill in strong passwords. .env is ignored by git.

# Nextcloud release to run, e.g. "stable" or a pinned major version such as "32"
NEXTCLOUD_VERSION=stable

HTTP_PORT=8080

# Space-separated list of domains the server may be reached on
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# Page that the "Get the apps" links (desktop, Android, iOS) open
MYSTICKCLOUD_APPS_URL=https://mystickcloud.com

# Online office (Euro-Office Document Server)
# OFFICE_URL is the address browsers use to reach the office service
OFFICE_URL=http://localhost:8091/
OFFICE_PORT=8091
OFFICE_JWT_SECRET=change-me-to-a-long-random-string
# Docker image of the document server, e.g. your own Personal Office build
OFFICE_IMAGE=ghcr.io/euro-office/documentserver:latest

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me

MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
